{
  "name": "@redscope-ai/redscope",
  "version": "1.0.7",
  "description": "RedScope AI - security-focused AI CLI for penetration testing, asset reconnaissance, threat tracing, and red-team orchestration",
  "type": "module",
  "author": "RedScope AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PuppetWen/RedScope-AI.git"
  },
  "homepage": "https://github.com/PuppetWen/RedScope-AI#readme",
  "bugs": {
    "url": "https://github.com/PuppetWen/RedScope-AI/issues"
  },
  "keywords": [
    "redscope",
    "security",
    "pentest",
    "red-team",
    "ai",
    "coding-assistant",
    "terminal",
    "repl"
  ],
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=18.0.0"
  },
  "bin": {
    "redscope": "dist/cli-node.js",
    "redscope-bun": "dist/cli-bun.js",
    "ccb": "dist/cli-node.js",
    "ccb-bun": "dist/cli-bun.js",
    "claude-code-best": "dist/cli-node.js"
  },
  "workspaces": [
    "packages/*",
    "packages/@ant/*",
    "packages/@anthropic-ai/*"
  ],
  "files": [
    "dist",
    "README.en.md",
    "scripts/postinstall.cjs",
    "scripts/run-parallel.mjs",
    "scripts/setup-chrome-mcp.mjs",
    "scripts/chrome-mcp-bridge-resolver.mjs",
    "scripts/chrome-mcp-env.mjs",
    "scripts/check-bundle-integrity.ts",
    "scripts/health-check.ts",
    "scripts/postinstall-redscope-bootstrap.cjs",
    "scripts/production-test.ts",
    "docs/fix-list-goal-mode.zh.md",
    "docs/fix-list-goal-mode.en.md",
    "tools/authorized-egress.referee-provided.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:vite": "vite build && bun run scripts/post-build.ts",
    "build:vite:only": "vite build",
    "build:bun": "bun run build.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:inspect": "bun run scripts/dev-debug.ts",
    "prepublishOnly": "bun run build && bun run redscope:publish-guard",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --fix src/",
    "format": "biome format --write src/",
    "test": "bun test",
    "test:production": "bun run scripts/production-test.ts",
    "test:production:offline": "bun run scripts/production-test.ts --offline",
    "test:production:verbose": "bun run scripts/production-test.ts --verbose",
    "test:production:bun": "bun run scripts/production-test.ts --bun",
    "check:bundle": "bun run scripts/check-bundle-integrity.ts",
    "check:unused": "knip-bun",
    "health": "bun run scripts/health-check.ts",
    "redscope:tool": "bun run scripts/redscope-tool-installer.ts",
    "redscope:profile": "bun run scripts/redscope-profile-runner.ts",
    "redscope:report": "bun run scripts/redscope-report-pipeline.ts",
    "redscope:observe": "bun run scripts/redscope-observability.ts",
    "redscope:graph": "bun run scripts/redscope-memory-graph.ts",
    "redscope:graph-import": "bun run scripts/redscope-graph-import.ts",
    "redscope:evtx": "bun run scripts/redscope-evtx-deep-parser.ts",
    "redscope:workflow": "bun run scripts/redscope-workflow.ts",
    "redscope:batch": "bun run scripts/redscope-batch-runner.ts",
    "redscope:command": "bun run scripts/redscope-command-adapter.ts",
    "redscope:deliver": "bun run scripts/redscope-delivery.ts",
    "redscope:drafts": "bun run scripts/redscope-draft-generator.ts",
    "redscope:sources": "bun run scripts/redscope-source-updater.ts",
    "redscope:egress": "bun run scripts/redscope-egress-policy.ts",
    "redscope:egress-refresh": "bun run scripts/redscope-egress-refresh.ts",
    "redscope:proxy-scrape": "bun run scripts/redscope-proxy-scrape.ts",
    "redscope:first-run": "bun run scripts/redscope-first-run.ts",
    "redscope:fingerprint-nday": "bun run scripts/redscope-fingerprint-nday.ts",
    "redscope:bootstrap": "node scripts/postinstall-redscope-bootstrap.cjs",
    "redscope:nuclei-setup": "bun run scripts/redscope-nuclei-setup.ts",
    "redscope:recon-map": "bun run scripts/gen-recon-map.ts",
    "redscope:poc-catalog": "bun run scripts/gen-poc-catalog.ts",
    "redscope:publish-guard": "bun run scripts/redscope-publish-guard.ts",
    "postinstall": "node scripts/run-parallel.mjs scripts/postinstall.cjs scripts/setup-chrome-mcp.mjs scripts/postinstall-redscope-bootstrap.cjs",
    "typecheck": "tsc --noEmit",
    "test:all": "bun run typecheck && bun test",
    "rcs": "bun run scripts/rcs.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.19.0",
